INPUT(clk)
INPUT(rst)
INPUT(ff_q_0)
INPUT(ff_q_1)
INPUT(ff_q_2)
INPUT(ff_q_3)
OUTPUT(ff_q_0)
OUTPUT(ff_q_1)
OUTPUT(ff_q_2)
OUTPUT(ff_q_3)
OUTPUT(n8)
OUTPUT(n12)
OUTPUT(n18)
OUTPUT(n15)
n8 = NOR(ff_q_0, rst)
n9 = AND(ff_q_0, ff_q_1)
n10 = NOR(ff_q_0, ff_q_1)
n11 = NOR(rst, n10)
n12_n = NOT(n9)
n12 = AND(n11, n12_n)
n13 = AND(ff_q_2, n9)
n16 = NOR(ff_q_2, n9)
n17 = NOR(rst, n16)
n18_n = NOT(n13)
n18 = AND(n17, n18_n)
n14 = XNOR(ff_q_3, n13)
n15 = NOR(rst, n14)
