
read_verilog -sv ref.v
hierarchy -top gray_cnt
proc; flatten; async2sync
rename gray_cnt gold
design -stash gold
read_verilog -sv user.v
hierarchy -check -top gray_cnt
proc; flatten; async2sync
rename gray_cnt gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_outputs -ignore_gold_x gold gate miter
hierarchy -top miter

sat -verify  -seq 40 -set-at 1 in_rst 1 -set-init-undef -enable_undef -set-def-inputs -prove trigger 0 -show-ports -dump_vcd cex.vcd miter
