-    if(line MATCHES "^VERSION_ID=(.*)$")
-      string(REGEX REPLACE "^VERSION_ID=\"?([^\"]*)\"?$" "\\1" OS_VERSION_ID "${line}")
-    endif()
-  endforeach()
