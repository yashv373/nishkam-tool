
read_verilog -sv ref.v
hierarchy -top mux2
proc; flatten; async2sync
rename mux2 gold
design -stash gold
read_verilog -sv user.v
hierarchy -check -top mux2
proc; flatten; async2sync
rename mux2 gate
design -stash gate
design -copy-from gold -as gold gold
design -copy-from gate -as gate gate
miter -equiv -flatten -make_outputs -ignore_gold_x gold gate miter
hierarchy -top miter

sat -verify -tempinduct -maxsteps 40 -seq 40  -set-init-undef -enable_undef -set-def-inputs -prove trigger 0 -show-ports -dump_vcd cex.vcd miter
