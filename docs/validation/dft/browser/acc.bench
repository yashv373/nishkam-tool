INPUT(clk)
INPUT(rst)
INPUT(d_0)
INPUT(d_1)
INPUT(go)
INPUT(ff_q_0)
INPUT(ff_q_1)
INPUT(ff_q_2)
OUTPUT(ff_q_0)
OUTPUT(ff_q_1)
OUTPUT(ff_q_2)
OUTPUT(n10)
OUTPUT(n19)
OUTPUT(n26)
OUTPUT(n23)
n12 = XNOR(ff_q_1, ff_q_0)
n14 = XNOR(ff_q_2, n12)
n10 = OR(go, n14)
n15 = NAND(ff_q_2, d_0)
n16 = NAND(go, n15)
n11 = NOT(rst)
n17 = OR(go, ff_q_0)
n18 = AND(n11, n17)
n19 = AND(n16, n18)
n24 = XOR(ff_q_0, d_0)
n25_s = NOT(go)
n25_a = AND(ff_q_1, n25_s)
n25_b = AND(n24, go)
n25 = OR(n25_a, n25_b)
n26 = AND(n11, n25)
n20 = XNOR(ff_q_1, d_1)
n21 = NAND(go, n20)
n13 = OR(go, ff_q_2)
n22 = AND(n11, n13)
n23 = AND(n21, n22)
